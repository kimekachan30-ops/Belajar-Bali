<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Belajar Bahasa Bali lewat Cerita</title>
  <style>
    :root { --laut:#1f5f6b; --pasir:#eef3f1; --kamboja:#f2b632; --putih:#fff; }
    body { font-family: Georgia, serif; background: var(--pasir); color: var(--laut); margin:0; padding:24px 16px; }
    main { max-width: 560px; margin: 0 auto; }
    h1 { font-size: 1.8rem; margin: 0 0 8px; }
    .cerita { background: var(--putih); padding: 16px; border-radius: 8px; line-height: 2.2; }
    /* Setiap kata adalah tombol kecil yang bisa diklik */
    .kata { background: none; border: none; font: inherit; color: inherit; cursor: pointer;
            padding: 2px 3px; border-bottom: 2px dotted var(--kamboja); }
    .kata:hover { background: var(--kamboja); }
    #hasil { margin-top: 16px; padding: 16px; background: var(--putih);
             border-left: 6px solid var(--kamboja); border-radius: 8px; min-height: 24px; }
    .catatan { font-size: .85rem; opacity: .8; }
  </style>
</head>
<body>
<main>
  <h1>Belajar Bahasa Bali lewat Cerita</h1>
  <p>Klik kata yang belum kamu mengerti.</p>
  <div class="cerita" id="cerita"></div>
  <div id="hasil">Belum ada kata yang dipilih.</div>
  <p class="catatan">Isi cerita dan kamus di bawah masih contoh. Wajib diganti dan diverifikasi oleh narasumber.</p>
</main>

<script>
  // 1. KAMUS: data dari narasumber (GANTI dengan data asli dari guru).
  const kamus = {
    "om":           "Bagian dari salam pembuka",
    "swastiastu":   "Semoga sejahtera",
    "matur":        "Kata sopan untuk 'mengatakan/menyampaikan'",
    "suksma":       "Terima kasih",
    "ampura":       "Maaf / permisi"
  };

  // 2. CERITA: tiap kalimat punya teks Latin dan aksara (isi aksara dari guru).
  const cerita = [
    { latin: "Om swastiastu", aksara: "" },
    { latin: "Matur suksma",  aksara: "" }
  ];

  // 3. TAMPILKAN CERITA: ubah tiap kata jadi tombol
  const kotakCerita = document.getElementById("cerita");
  cerita.forEach(function (kalimat) {
    const baris = document.createElement("p");
    kalimat.latin.split(" ").forEach(function (kata) {
      const tombol = document.createElement("button");
      tombol.className = "kata";
      tombol.textContent = kata;
      tombol.onclick = function () { klikKata(kata, kalimat.latin); };
      baris.appendChild(tombol);
    });
    kotakCerita.appendChild(baris);
  });

  // 4. SAAT KATA DIKLIK
  async function klikKata(kata, kalimat) {
    const hasil = document.getElementById("hasil");
    const kunci = kata.toLowerCase();

    // a) Kalau ada di kamus dari guru, pakai itu (paling dipercaya)
    if (kamus[kunci]) {
      hasil.textContent = kata + " = " + kamus[kunci];
      return;
    }

    // b) Kalau tidak ada, tanya AI lewat backend kita (/api/jelaskan)
    hasil.textContent = "Menanyakan ke AI...";
    try {
      const respon = await fetch("/api/jelaskan", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ kata: kata, kalimat: kalimat, kamus: kamus })
      });
      if (!respon.ok) throw new Error("Server error");
      const data = await respon.json();
      hasil.textContent = data.jawaban + " (penjelasan AI, mungkin kurang tepat)";
    } catch (e) {
      hasil.textContent = "AI belum tersambung. Jalankan lewat Vercel, bukan klik dua kali file.";
    }
  }
</script>
</body>
</html>